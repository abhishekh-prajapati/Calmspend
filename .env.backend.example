# ==========================================
# PBP Backend - Setu Account Aggregator Config (Example)
# ==========================================

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------
# Setu Sandbox Credentials (from Setu Bridge)
# ------------------------------------------
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=your_setu_client_id_here
SETU_CLIENT_SECRET=your_setu_client_secret_here
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id_here
SETU_WEBHOOK_SECRET=your_setu_webhook_secret_here
SETU_REDIRECT_URL=http://localhost:5173/aa/callback
SETU_SANDBOX_SIMULATOR=false
